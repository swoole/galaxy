GALAXY_IMAGE=registry.cn-shanghai.aliyuncs.com/swoole-public/galaxy
GALAXY_VERSION=latest
GALAXY_PUBLIC_URL=http://localhost:8080
GALAXY_HTTP_PORT=8080
GALAXY_SSH_PORT=9522
TZ=Asia/Shanghai

MYSQL_DATABASE=code_galaxy
MYSQL_USER=galaxy
MYSQL_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-random-root-password

SIMPLE_JWT_SECRET=replace-with-random-secret
SSO_JWT_SECRET=replace-with-random-secret
ENCRYPT_KEY=replace-with-random-secret
SWARM_CREDENTIAL_KEY=replace-with-random-secret
SSH_RELAY_INTERNAL_TOKEN=replace-with-random-secret
GALAXY_INSTALL_TOKEN=replace-with-random-install-token

GALAXY_ADMIN_EMAIL=admin@example.com
